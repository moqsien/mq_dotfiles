export JAVA_HOME=/usr/lib/jvm/java-17-openjdk
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export NDK_HOME="$ANDROID_HOME/ndk/30.0.16248370"

export NOTION_API_TOKEN=""
export QT_QPA_PLATFORM=wayland

