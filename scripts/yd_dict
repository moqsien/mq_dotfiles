#!/usr/bin/env python3

import gzip
import html
import json
import os
import re
import subprocess
import sys
import urllib.parse
import urllib.request
import zlib
from typing import Any, Dict, List, Optional, Tuple


class YoudaoDictionary:
    HEADERS = {
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8",
        "Accept-Encoding": "gzip, deflate",
        "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8",
        "Connection": "keep-alive",
        "Host": "dict.youdao.com",
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36",
        "sec-ch-ua": '"Chromium";v="152", "Not?A_Brand";v="24", "Google Chrome";v="152"',
        "sec-ch-ua-mobile": "?0",
        "sec-ch-ua-platform": '"Linux"',
    }

    def __init__(self, headers: Optional[Dict[str, str]] = None, timeout: int = 5):
        self.headers = headers or self.HEADERS.copy()
        self.timeout = timeout

    def fetch_word(self, word: str) -> Dict[str, Any]:
        url = f"http://dict.youdao.com/jsonapi?q={urllib.parse.quote(word)}"
        req = urllib.request.Request(url, headers=self.headers)
        try:
            with urllib.request.urlopen(req, timeout=self.timeout) as response:
                raw_data = response.read()
                encoding = response.info().get("Content-Encoding")
                if encoding == "gzip":
                    raw_data = gzip.decompress(raw_data)
                elif encoding == "deflate":
                    raw_data = zlib.decompress(raw_data)
                return self._decode_json(raw_data)
        except Exception as error:
            return {"error": str(error)}

    @staticmethod
    def _decode_json(raw_data: bytes) -> Dict[str, Any]:
        if raw_data.startswith(b"\xef\xbb\xbf"):
            raw_data = raw_data[3:]
        try:
            text = raw_data.decode("utf-8")
        except UnicodeDecodeError:
            text = raw_data.decode("gb18030")
        return json.loads(text)

    @staticmethod
    def clean(text: Any) -> str:
        if not isinstance(text, str):
            return str(text)
        text = html.unescape(text)
        return re.sub(r"</?[^>]+>", "", text).strip()

    @classmethod
    def _texts_from_l(cls, node: Any) -> List[str]:
        if isinstance(node, str):
            return [node]
        if isinstance(node, list):
            output: List[str] = []
            for item in node:
                output.extend(cls._texts_from_l(item))
            return output
        if isinstance(node, dict):
            output = []
            for value in node.values():
                output.extend(cls._texts_from_l(value))
            return output
        return []

    @classmethod
    def _walk_trs(cls, node: Any, definitions: List[str]):
        if isinstance(node, list):
            for item in node:
                cls._walk_trs(item, definitions)
        elif isinstance(node, dict):
            if "l" in node:
                definitions.extend(
                    cls.clean(text) for text in cls._texts_from_l(node["l"])
                )
            for translation in node.get("tr", []):
                if not isinstance(translation, dict):
                    continue
                pos = translation.get("pos", "")
                texts = [
                    cls.clean(text)
                    for text in translation.get("tr", [])
                    if isinstance(text, str)
                ]
                if "l" in translation:
                    texts.extend(
                        cls.clean(text) for text in cls._texts_from_l(translation["l"])
                    )
                if texts:
                    definitions.append((pos + " " if pos else "") + "; ".join(texts))

    @staticmethod
    def extract_phones(data: Dict[str, Any]) -> Tuple[str, str, str]:
        basic = data.get("basic") or {}
        uk = basic.get("uk-phonetic", "")
        us = basic.get("us-phonetic", "")
        phonetic = basic.get("phonetic", "")
        if uk or us or phonetic:
            return uk, us, phonetic

        for source in ("ec", "simple"):
            words = (data.get(source) or {}).get("word", [])
            if isinstance(words, list) and words and isinstance(words[0], dict):
                uk = words[0].get("ukphone", "")
                us = words[0].get("usphone", "")
                if uk or us:
                    return uk, us, ""
        return "", "", ""

    @staticmethod
    def extract_prototype(data: Dict[str, Any]) -> str:
        words = (data.get("ec") or {}).get("word", [])
        if isinstance(words, list):
            for word in words:
                if isinstance(word, dict) and word.get("prototype"):
                    return word["prototype"]
        return ""

    @classmethod
    def extract_definitions(cls, data: Dict[str, Any]) -> List[str]:
        definitions: List[str] = []
        basic = data.get("basic") or {}
        definitions.extend(cls.clean(exp) for exp in basic.get("explains", []))

        for word_info in (data.get("expand_ec") or {}).get("word", []):
            pos = word_info.get("pos", "")
            translations = []
            for translation in word_info.get("transList", []):
                content = translation.get("content") or {}
                text = content.get("trans") or translation.get("trans") or ""
                if text:
                    translations.append(cls.clean(text))
            if translations:
                translation_text = "; ".join(translations)
                if pos:
                    definitions.append(f"[{pos}] {translation_text}")
                else:
                    definitions.append(translation_text)

        for word in (data.get("ec") or {}).get("word", []):
            if isinstance(word, dict):
                for group in word.get("trs", []):
                    cls._walk_trs(group, definitions)

        return cls._unique(definitions)

    @classmethod
    def extract_english_definitions(cls, data: Dict[str, Any]) -> List[str]:
        definitions: List[str] = []

        ee = data.get("ee") or {}
        word = ee.get("word") if isinstance(ee, dict) else {}
        for group in cls._items((word or {}).get("trs")):
            pos = group.get("pos", "")
            for translation in cls._items(group.get("tr")):
                for definition in cls._texts_from_l(translation.get("l")):
                    definition = cls.clean(definition)
                    if definition:
                        definitions.append(
                            f"[{pos}] {definition}" if pos else definition
                        )

        collins = data.get("collins") or {}
        if isinstance(collins, dict):
            for collection in cls._items(collins.get("collins_entries")):
                entries = collection.get("entries") or {}
                for entry in cls._items(entries.get("entry")):
                    for translation_entry in cls._items(entry.get("tran_entry")):
                        translation = cls.clean(translation_entry.get("tran", ""))
                        translation = cls._english_prefix(translation)
                        if translation:
                            pos_entry = translation_entry.get("pos_entry") or {}
                            pos = pos_entry.get("pos", "")
                            definitions.append(
                                f"[{pos}] {translation}" if pos else translation
                            )

        webster = data.get("webster") or {}
        if isinstance(webster, dict):
            values = []
            for key in ("definitions", "definition", "shortdef", "short_definitions"):
                values.extend(cls._texts_from_l(webster.get(key)))
            for entry in cls._items(webster.get("entries")):
                for key in (
                    "definitions",
                    "definition",
                    "shortdef",
                    "short_definitions",
                ):
                    values.extend(cls._texts_from_l(entry.get(key)))
            definitions.extend(
                text
                for value in values
                if (text := cls._english_prefix(cls.clean(value)))
            )

        return cls._unique(definitions)

    @staticmethod
    def _items(node: Any) -> List[Dict[str, Any]]:
        if isinstance(node, dict):
            return [node]
        if isinstance(node, list):
            return [item for item in node if isinstance(item, dict)]
        return []

    @staticmethod
    def _english_prefix(text: str) -> str:
        return re.split(r"[\u3400-\u9fff]", text, maxsplit=1)[0].strip(" ;,")

    @staticmethod
    def _unique(values: List[str]) -> List[str]:
        unique: List[str] = []
        seen = set()
        for value in values:
            if value and value not in seen:
                seen.add(value)
                unique.append(value)
        return unique

    @classmethod
    def extract_examples(
        cls, data: Dict[str, Any], limit: int = 3
    ) -> List[Tuple[str, str]]:
        examples: List[Tuple[str, str]] = []
        for word_info in (data.get("expand_ec") or {}).get("word", []):
            for translation in word_info.get("transList", []):
                for sentence in (translation.get("content") or {}).get("sents", []):
                    original = cls.clean(sentence.get("sentOrig", ""))
                    translated = cls.clean(sentence.get("sentTrans", ""))
                    if original:
                        examples.append((original, translated))

        if not examples:
            for pair in (data.get("blng_sents_part") or {}).get("sentence-pair", []):
                original = cls.clean(
                    pair.get("sentence-eng", "") or pair.get("sentence", "")
                )
                translated = cls.clean(pair.get("sentence-translation", ""))
                if original:
                    examples.append((original, translated))

        if not examples:
            for sentence in (data.get("auth_sents_part") or {}).get("sent", []):
                original = cls.clean((sentence.get("foreign") or "").strip())
                if original:
                    examples.append((original, ""))
        return examples[:limit]

    @classmethod
    def extract_web_translations(cls, data: Dict[str, Any]) -> List[str]:
        output = []
        web_items = (data.get("web_trans") or {}).get("web-translation", [])
        for item in web_items[:3]:
            key = cls.clean(item.get("key", ""))
            values = [
                cls.clean(translation.get("value", ""))
                for translation in item.get("trans", [])
                if isinstance(translation, dict) and translation.get("value")
            ]
            if key and values:
                output.append(f"  - {key}: {', '.join(values)}")
        return output


class DictionaryFormatter:
    def __init__(self, youdao: YoudaoDictionary):
        self.youdao = youdao

    def format(
        self,
        youdao_data: Dict[str, Any],
        prototype_data: Optional[Dict[str, Any]],
        prototype: str = "",
    ) -> str:
        lines: List[str] = []
        if "error" in youdao_data:
            lines.append(f"请求失败: {youdao_data['error']}")

        youdao_uk, youdao_us, youdao_phonetic = self.youdao.extract_phones(youdao_data)
        uk = youdao_uk
        us = youdao_us
        if uk or us:
            phones = []
            if uk:
                phones.append(f"UK [{uk}]")
            if us:
                phones.append(f"US [{us}]")
            lines.append("发音  " + "    ".join(phones))
        elif youdao_phonetic:
            lines.append(f"发音  [{youdao_phonetic}]")
        if prototype:
            lines.append(f"原形: {prototype}")
        if uk or us or youdao_phonetic or prototype:
            lines.append("-" * 45)

        definitions = self.youdao.extract_definitions(youdao_data)
        if prototype_data:
            for definition in self.youdao.extract_definitions(prototype_data):
                if definition not in definitions:
                    definitions.append(definition)
        for definition in definitions[:8]:
            lines.append(f"- {definition}")

        english_definitions = self.youdao.extract_english_definitions(youdao_data)
        if prototype_data:
            for definition in self.youdao.extract_english_definitions(prototype_data):
                if definition not in english_definitions:
                    english_definitions.append(definition)
        if english_definitions:
            if definitions:
                lines.append("")
            lines.append("英英释义:")
            for definition in english_definitions[:8]:
                lines.append(f"  - {definition}")

        examples = self.youdao.extract_examples(youdao_data)
        if not examples and prototype_data:
            examples = self.youdao.extract_examples(prototype_data)
        if examples:
            lines.append("")
            lines.append("例句:")
            for original, translated in examples:
                lines.append(f"  - {original}")
                if translated:
                    lines.append(f"    {translated}")

        web_translations = self.youdao.extract_web_translations(youdao_data)
        if web_translations:
            lines.append("")
            lines.append("专业/网络释义:")
            lines.extend(web_translations)

        if (
            not definitions
            and not english_definitions
            and youdao_data.get("translation")
        ):
            lines.append("基础翻译:")
            lines.append("  " + ", ".join(youdao_data["translation"]))

        if not lines:
            with open(
                "/tmp/sioyek_dict_debug.log", "a", encoding="utf-8"
            ) as debug_file:
                debug_file.write(f"[未解析] keys={list(youdao_data.keys())}\n")
            return "未找到该词的详细释义。"

        return "\n".join(lines)


class DictionaryService:
    def __init__(
        self,
        youdao: Optional[YoudaoDictionary] = None,
    ):
        self.youdao = youdao or YoudaoDictionary()
        self.formatter = DictionaryFormatter(self.youdao)

    def query(self, word: str) -> str:
        youdao_data = self.youdao.fetch_word(word)
        prototype = self.youdao.extract_prototype(youdao_data)
        prototype_data = None
        if prototype and prototype.lower() != word.lower():
            prototype_data = self.youdao.fetch_word(prototype)
        return self.formatter.format(
            youdao_data,
            prototype_data,
            prototype,
        )


class PopupNotifier:
    def __init__(self):
        if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
            os.environ["DISPLAY"] = ":0"

    def show(self, word: str, message: str):
        safe = message.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
        command = [
            "zenity",
            "--info",
            f"--title=词典 · {word}",
            f"--text={safe}",
            "--width=520",
            "--ok-label=关闭",
        ]
        try:
            if (
                subprocess.run(
                    command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                ).returncode
                == 0
            ):
                return
        except FileNotFoundError:
            pass

        try:
            flat_message = message.replace("\n", " | ")
            subprocess.run(
                ["notify-send", f"词典 · {word}", flat_message, "-t", "8000"],
                check=True,
            )
            return
        except Exception:
            pass

        with open("/tmp/sioyek_dict_debug.log", "a", encoding="utf-8") as debug_file:
            debug_file.write(f"[弹窗失败] {word}: {message}\n")


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1].strip():
        word = sys.argv[1].strip().strip('"').strip("'").strip()
        message = DictionaryService().query(word)
        PopupNotifier().show(word, message)
